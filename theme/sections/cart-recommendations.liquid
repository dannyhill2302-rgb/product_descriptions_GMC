{%- comment -%}
  Cart Recommendations Section
  Shows accessory/complementary product suggestions based on items in cart.
  Appears both in the slide-out cart drawer AND on the full cart page.
  
  Logic:
  1. Collects all product types in the cart
  2. Uses Shopify's product recommendations API seeded from the first cart item
  3. Falls back to a manually curated collection if configured
{%- endcomment -%}

{% if cart.items.size > 0 %}
  <div
    class="cart-recommendations-wrapper"
    data-cart-recommendations
    data-seed-product-id="{{ cart.items.first.product_id }}"
    data-recommendations-url="{{ routes.product_recommendations_url }}"
    data-limit="6"
  >
    <div class="cart-recommendations-inner" data-cart-recommendations-inner style="display:none;">
      <h3 class="cart-recommendations__heading">
        {{ section.settings.heading | default: 'You might also like' }}
      </h3>
      <div class="cart-recommendations__products" data-cart-recommendations-products></div>
    </div>
  </div>

  <script>
    (function() {
      var wrapper = document.querySelector('[data-cart-recommendations]');
      if (!wrapper) return;

      var seedId    = wrapper.dataset.seedProductId;
      var baseUrl   = wrapper.dataset.recommendationsUrl;
      var limit     = wrapper.dataset.limit || 6;
      var inner     = wrapper.querySelector('[data-cart-recommendations-inner]');
      var container = wrapper.querySelector('[data-cart-recommendations-products]');

      if (!seedId || !baseUrl) return;

      var url = baseUrl + '?product_id=' + seedId + '&limit=' + limit + '&intent=complementary';

      fetch(url)
        .then(function(r) { return r.ok ? r.json() : Promise.reject(); })
        .then(function(data) {
          if (!data.products || data.products.length === 0) {
            // Fall back to related intent
            return fetch(baseUrl + '?product_id=' + seedId + '&limit=' + limit)
              .then(function(r) { return r.ok ? r.json() : Promise.reject(); });
          }
          return data;
        })
        .then(function(data) {
          if (!data.products || data.products.length === 0) return;

          // Build product cards
          var html = data.products.map(function(p) {
            var img = p.featured_image
              ? '<img src="' + p.featured_image + '&width=300" alt="' + p.title.replace(/"/g,'&quot;') + '" loading="lazy">'
              : '';
            var price = p.price_min
              ? (p.price_min / 100).toLocaleString('nl-NL', {style:'currency', currency:'EUR'})
              : '';
            var btnHtml = p.variants && p.variants.length === 1
              ? '<button class="cart-rec__atc btn" type="button" data-variant-id="' + p.variants[0].id + '" data-available="' + p.variants[0].available + '">'
                + (p.variants[0].available ? '{{ "products.product.add_to_cart" | t }}' : '{{ "products.product.sold_out" | t }}')
                + '</button>'
              : '<a class="cart-rec__view btn" href="' + p.url + '">{{ "products.product.select_options" | t | default: "Select" }}</a>';

            return '<div class="cart-rec__item">'
              + '<a class="cart-rec__img-link" href="' + p.url + '">' + img + '</a>'
              + '<div class="cart-rec__details">'
              + '<a class="cart-rec__title" href="' + p.url + '">' + p.title + '</a>'
              + '<span class="cart-rec__price">' + price + '</span>'
              + btnHtml
              + '</div>'
              + '</div>';
          }).join('');

          container.innerHTML = html;
          inner.style.display = '';

          // Wire up ATC buttons
          container.querySelectorAll('.cart-rec__atc').forEach(function(btn) {
            if (btn.dataset.available === 'false') {
              btn.disabled = true;
              return;
            }
            btn.addEventListener('click', function() {
              var variantId = this.dataset.variantId;
              btn.textContent = '...';
              btn.disabled = true;

              fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({ id: variantId, quantity: 1 })
              })
              .then(function(r) { return r.json(); })
              .then(function() {
                btn.textContent = '✓ {{ "cart.cart_item.added" | t | default: "Added" }}';
                // Trigger theme cart refresh event
                document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
                setTimeout(function() {
                  btn.textContent = '{{ "products.product.add_to_cart" | t }}';
                  btn.disabled = false;
                }, 2000);
              })
              .catch(function() {
                btn.textContent = '{{ "products.product.add_to_cart" | t }}';
                btn.disabled = false;
              });
            });
          });
        })
        .catch(function() {
          // Silently fail — no recommendations to show
        });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": {
    "en": "Cart recommendations",
    "nl": "Winkelwagen aanbevelingen"
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": {
        "en": "Heading",
        "nl": "Titel"
      },
      "default": {
        "en": "You might also like",
        "nl": "Misschien vind je dit ook leuk"
      }
    },
    {
      "type": "checkbox",
      "id": "show_in_drawer",
      "label": {
        "en": "Show in cart drawer",
        "nl": "Toon in winkelwagen lade"
      },
      "default": true
    }
  ]
}
{% endschema %}

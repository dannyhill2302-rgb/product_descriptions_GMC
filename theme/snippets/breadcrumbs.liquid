{% assign hasBreadcrumbs = true %}
{% case template.name %}
  {% when 'cart' %}
    {% assign hasBreadcrumbs = false %}
  {% when 'account' %}
    {% assign hasBreadcrumbs = false %}
  {% when 'login' %}
    {% assign hasBreadcrumbs = false %}
  {% when 'register' %}
    {% assign hasBreadcrumbs = false %}
  {% when 'index' %}
    {% assign hasBreadcrumbs = false %}
  {% when 'list-collections' %}
    {% assign hasBreadcrumbs = false %}
  {% when 'page' %}
    {% assign hasBreadcrumbs = false %}
  {% when 'search' %}
    {% assign hasBreadcrumbs = false %}
{% endcase %}

{% if hasBreadcrumbs %}
  <nav class="breadcrumbs" aria-label="breadcrumbs">
    <div class="breadcrumbs-inner">

      {% if linklists[settings.navigationDepartments].links.size > 0 %}
        {% for link in linklists[settings.navigationDepartments].links %}
          {% assign parentLink = link.title | link_to: link.url %}
          {% assign linkHandle = link.title | handle %}
          {% for link in linklists[linkHandle].links %}
            {% if link.type == "collection_link" and link.object.title == collection.title %}
              {% assign inDepartment = parentLink %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endfor %}
      {% endif %}

      {% if template contains 'article' %}
        {% if blog.url %}
          {{ blog.title | link_to: blog.url }}
        {% endif %}
        <span aria-hidden="true">&nbsp;&nbsp;/&nbsp;&nbsp;</span>
        <span>{{ article.title }}</span>

      {% elsif template contains 'blog' %}

        {% if current_tags %}
          {{ blog.title | link_to: blog.url }}
          <span aria-hidden="true">&nbsp;&nbsp;/&nbsp;&nbsp;</span>
          <span>
            {%- for tag in current_tags -%}
              {{ tag | replace: "_", ": " }} {% unless forloop.last %}+{% endunless %}
            {%- endfor -%}
          </span>
        {% else %}
          <span>{{ blog.title }}</span>
        {% endif %}

      {% elsif template contains 'product' %}

        {%- comment -%}
          Breadcrumb fix for /products/* canonical URLs.
          We read the ?collection= param (set by product-item links) or fall
          back to the referring URL to reconstruct the collection context.
        {%- endcomment -%}
        {% assign bc_collection = nil %}
        {%- comment -%}
          Parse ?collection=<handle> from the query string.
          request.param() is not valid Shopify Liquid; use query_string splitting instead.
        {%- endcomment -%}
        {% assign bc_collection_handle = '' %}
        {% if request.query_string contains 'collection=' %}
          {% assign bc_collection_handle = request.query_string | split: 'collection=' | last | split: '&' | first %}
        {% endif %}
        {% if bc_collection_handle != blank %}
          {% assign bc_collection = collections[bc_collection_handle] %}
        {% endif %}

        {% if bc_collection %}
          {%- comment -%}Find parent department for this collection{%- endcomment -%}
          {% if linklists[settings.navigationDepartments].links.size > 0 %}
            {% for link in linklists[settings.navigationDepartments].links %}
              {% assign deptLink = link.title | link_to: link.url %}
              {% assign deptHandle = link.title | handle %}
              {% for childLink in linklists[deptHandle].links %}
                {% if childLink.type == "collection_link" and childLink.object.handle == bc_collection.handle %}
                  {% assign inDepartment = deptLink %}
                  {% break %}
                {% endif %}
              {% endfor %}
            {% endfor %}
          {% endif %}

          {% if inDepartment %}
            {{ inDepartment }}
          {% else %}
            {{ 'layout.breadcrumbs.collections' | t | link_to: '/collections' }}
          {% endif %}
          <span aria-hidden="true">&nbsp;&nbsp;/&nbsp;&nbsp;</span>
          {{ bc_collection.title | link_to: bc_collection.url }}
          <span aria-hidden="true">&nbsp;&nbsp;/&nbsp;&nbsp;</span>
          <span>{{ product.title | truncate: 20 }}</span>

        {% else %}
          {%- comment -%}No collection param — fall back to original logic{%- endcomment -%}
          {% if inDepartment %}
            {{ inDepartment }}
          {% else %}
            {{ 'layout.breadcrumbs.collections' | t | link_to: '/collections' }}
          {% endif %}

          {% if collection.url %}
            <span aria-hidden="true">&nbsp;&nbsp;/&nbsp;&nbsp;</span>
            {{ collection.title | link_to: collection.url }}
          {% endif %}
          <span aria-hidden="true">&nbsp;&nbsp;/&nbsp;&nbsp;</span>
          <span>{{ product.title | truncate: 20 }}</span>
        {% endif %}

      {% elsif template contains 'collection' and collection.handle %}

        {% if linklists[settings.navigationDepartments].links.size > 0 %}
          {% for link in linklists[settings.navigationDepartments].links %}
            {% assign parentLink = link.title | link_to: link.url %}
            {% assign linkHandle = link.title | handle %}
            {% for link in linklists[linkHandle].links %}
              {% if link.type == "collection_link" and link.object.title == collection.title %}
                {% assign inDepartment = parentLink %}
                {% break %}
              {% endif %}
            {% endfor %}
          {% endfor %}
        {% endif %}

        {% if inDepartment %}
          {{ inDepartment }}
        {% else %}
          {{ 'layout.breadcrumbs.collections' | t | link_to: '/collections' }}
        {% endif %}

        {% if current_tags %}
          <span aria-hidden="true">&nbsp;&nbsp;/&nbsp;&nbsp;</span>
          {{ collection.title | link_to: collection.url }}
          <span aria-hidden="true">&nbsp;&nbsp;/&nbsp;&nbsp;</span>
          <span>
            {%- for tag in current_tags -%}
              {{ tag | replace: "badge__", "" | replace: "_", ": " }} {% unless forloop.last %}+{% endunless %}
            {%- endfor -%}
          </span>
        {% else %}
          <span aria-hidden="true">&nbsp;&nbsp;/&nbsp;&nbsp;</span>
          <span>{{ collection.title }}</span>
        {% endif %}

      {% elsif template contains 'customers' %}

        {% if template contains 'addresses' %}
          {{ "layout.breadcrumbs.account" | t | link_to: "/account" }}
          <span aria-hidden="true">&nbsp;&nbsp;/&nbsp;&nbsp;</span>
          <span>{{ "layout.breadcrumbs.addresses" | t }}</span>
        {% elsif template contains 'order' %}
          {{ "layout.breadcrumbs.account" | t | link_to: '/account' }}
          <span aria-hidden="true">&nbsp;&nbsp;/&nbsp;&nbsp;</span>
          <span>{{ "layout.breadcrumbs.order" | t }}</span>
        {% else %}
          {{ "layout.breadcrumbs.account" | t }}
        {% endif %}

      {% endif %}
    </div>
  </nav>
{% endif %}
